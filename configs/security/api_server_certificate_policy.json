{
  "policy_version": 1,
  "certificate_name": "ClimateAdapt Prediction API Server v1",
  "purpose": "Authenticate the local ClimateAdapt prediction API during TLS and mutual-TLS connections.",
  "subject": {
    "country_name": "NZ",
    "organisation_name": "ClimateAdapt AI Prototype",
    "organisational_unit_name": "IT8527 Security Assessment",
    "common_name": "climateadapt-api.local"
  },
  "key": {
    "algorithm": "RSA",
    "size_bits": 3072,
    "public_exponent": 65537,
    "private_key_format": "Encrypted PKCS#8"
  },
  "certificate": {
    "signature_hash": "SHA-256",
    "validity_days": 365,
    "is_ca": false,
    "extended_key_usage": [
      "server_authentication"
    ],
    "key_usage": [
      "digital_signature",
      "key_encipherment"
    ],
    "subject_alternative_names": {
      "dns": [
        "localhost",
        "climateadapt-api.local"
      ],
      "ip": [
        "127.0.0.1",
        "::1"
      ]
    }
  },
  "issuer": {
    "certificate_path": "security/public/certificates/climateadapt_root_ca_v1.crt",
    "private_key_path": "security/private/ca/climateadapt_root_ca_v1.key"
  },
  "outputs": {
    "private_key_path": "security/private/server/climateadapt_api_server_v1.key",
    "certificate_path": "security/public/certificates/climateadapt_api_server_v1.crt",
    "certificate_chain_path": "security/public/certificates/climateadapt_api_server_v1_chain.crt",
    "evidence_path": "outputs/security_assessment_v1/server_certificate_generation_evidence_v1.json"
  },
  "security_controls": {
    "private_key_must_be_encrypted": true,
    "private_key_must_not_be_committed": true,
    "password_must_not_be_recorded": true,
    "certificate_must_be_ca_signed": true,
    "hostname_verification_required": true
  }
}
